# Full Service Pros — Claude Stack Personal API Keys
# Copy this file to ~/.claude/.env and fill in your own keys.
# Never commit this file or share it with anyone.
#
# How to connect integrations: https://claude.ai/settings/integrations
# Each person on the team gets their own keys below.

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=

# ── Gmail / Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── OpenAI / Codex ─────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── ElevenLabs (voice — optional) ──────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Ramp ───────────────────────────────────────────────────────────────────
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# ── QuickBooks ─────────────────────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# ── n8n (workflow automation MCP) ──────────────────────────────────────────
# Get your token from: https://enterpriseact.app.n8n.cloud → Settings → API → MCP Server
N8N_MCP_TOKEN=

# ── FSP Brain (shared team knowledge base) ─────────────────────────────────
# FSP_BRAIN_URL is the same for everyone.
# FSP_BRAIN_TOKEN is personal — Mark will DM yours to you. Do not share it.
# FSP_STAFF_NAME is optional (v2 derives your name from your token automatically),
# but set it as a fallback during the rollout period.
FSP_BRAIN_URL=https://kycmufnisrdrvwsgydnh.supabase.co/functions/v1/fsp-brain
FSP_BRAIN_TOKEN=
FSP_STAFF_NAME=

