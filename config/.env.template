# Full Service Pros — Claude Stack Personal API Keys
# Copy this file to ~/.claude/.env and fill in your own keys.
# Never commit this file or share it with anyone.
#
# How to connect integrations: https://claude.ai/settings/integrations
# Each person on the team gets their own keys below.

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=

# ── Gmail / Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── OpenAI / Codex ─────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── ElevenLabs (voice — optional) ──────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Ramp ───────────────────────────────────────────────────────────────────
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# ── QuickBooks ─────────────────────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# ── n8n (workflow automation MCP) ──────────────────────────────────────────
# Get your token from: https://enterpriseact.app.n8n.cloud → Settings → API → MCP Server
N8N_MCP_TOKEN=

# ── Apify (Instagram / web scraping) ──────────────────────────────────────
# Sign up free at https://apify.com → Account → Integrations → API tokens
APIFY_API_TOKEN=

# ── Add more as Mark wires new MCPs ────────────────────────────────────────
