# Full Service Pros — Claude Stack Personal API Keys
# Copy this file to ~/.claude/.env and fill in your own keys.
# Never commit this file or share it with anyone.
#
# How to connect integrations: https://claude.ai/settings/integrations
# Each person on the team gets their own keys below.

# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=

# ── Gmail / Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── OpenAI / Codex ─────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── ElevenLabs (voice — optional) ──────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Ramp ───────────────────────────────────────────────────────────────────
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# ── QuickBooks ─────────────────────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# ── n8n (workflow automation MCP) ──────────────────────────────────────────
# Get your token from: https://enterpriseact.app.n8n.cloud → Settings → API → MCP Server
N8N_MCP_TOKEN=

# ── Apify (Instagram / web scraping) ──────────────────────────────────────
# Sign up free at https://apify.com → Account → Integrations → API tokens
APIFY_API_TOKEN=

# ── Vapi.ai (personal voice assistant) ────────────────────────────────────────
# Sign up at https://vapi.ai → Dashboard → API Keys
VAPI_API_KEY=

# Populated automatically by: python3 scripts/vapi_setup.py
# Do not set these manually — run the script instead.
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=

# ElevenLabs voice ID (optional — leave blank to use Vapi's built-in "will" voice)
# Find voice IDs at: https://elevenlabs.io/voice-library
# Requires your ElevenLabs API key configured in the Vapi dashboard → Keys
ELEVENLABS_VOICE_ID=

# ── Add more as Mark wires new MCPs ────────────────────────────────────────
