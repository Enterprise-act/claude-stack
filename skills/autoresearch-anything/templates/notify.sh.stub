#!/bin/bash
# =============================================================================
# notify.sh - Notification Script
# =============================================================================
# Contract: Sends a notification message to the configured channel.
#
# USAGE:
#   bash notify.sh "Your message here"
#
# SUPPORTED CHANNELS (configured via .env):
#   - Telegram: requires BOT_TOKEN and CHAT_ID
#   - Slack: requires SLACK_WEBHOOK_URL
#   - None: falls back to terminal echo
#
# TODO: Your Claude Code agent will configure this during setup based on
# your notification preference.
# =============================================================================

set -euo pipefail

MESSAGE="${1:-No message provided}"

# Source environment variables
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "${SCRIPT_DIR}/.env" ]]; then
    set -a
    source "${SCRIPT_DIR}/.env"
    set +a
fi

# Telegram
if [[ -n "${BOT_TOKEN:-}" && -n "${CHAT_ID:-}" ]]; then
    curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
        -d chat_id="${CHAT_ID}" \
        -d text="${MESSAGE}" \
        -d parse_mode="Markdown" \
        > /dev/null 2>&1
    exit 0
fi

# Slack
if [[ -n "${SLACK_WEBHOOK_URL:-}" ]]; then
    curl -s -X POST "${SLACK_WEBHOOK_URL}" \
        -H "Content-Type: application/json" \
        -d "{\"text\": \"${MESSAGE}\"}" \
        > /dev/null 2>&1
    exit 0
fi

# Fallback: terminal
echo "${MESSAGE}"
